{
  "name": "trending-repos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "npm run db:migrate && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply trending-repos --local",
    "db:migrate": "wrangler d1 migrations apply trending-repos --remote",
    "test": "vitest run",
    "og": "google-chrome --headless=new --disable-gpu --hide-scrollbars --allow-file-access-from-files --window-size=1200,630 --screenshot=public/og.png \"file://$PWD/scripts/og-image.html\""
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
