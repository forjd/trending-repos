{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trending-repos",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Scrape github.com/trending every 4 hours
  "triggers": { "crons": ["0 */4 * * *"] },

  // Latest scrape result, stored under a single key
  "kv_namespaces": [{ "binding": "TRENDING", "id": "9d067e26557c42198b6ff200929bac00" }],

  // History: one row per repo per scrape. Schema lives in migrations/
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trending-repos",
      "database_id": "60de0073-b3e1-495e-bc8a-da34033aaf43",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (not committed): REFRESH_KEY for POST /__refresh, optional GITHUB_TOKEN.
  // Set with `wrangler secret put <NAME>`
  // For local dev, put it in .dev.vars
}
